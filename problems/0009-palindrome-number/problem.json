{
  "id": 9,
  "slug": "palindrome-number",
  "title": "Palindrome Number",
  "difficulty": "Easy",
  "tags": [
    "Math"
  ],
  "statement": "Return `true` if the integer `x` reads the same forwards and backwards, otherwise `false`.\n\nNegative numbers are never palindromes. Try to solve it without converting the integer to a string.",
  "constraints": [
    "`-2^31 <= x <= 2^31 - 1`"
  ],
  "signature": {
    "name": "isPalindrome",
    "params": [
      {
        "name": "x",
        "type": "int"
      }
    ],
    "returns": "bool"
  },
  "examples": [
    {
      "input": {
        "x": 121
      },
      "output": true
    },
    {
      "input": {
        "x": -121
      },
      "output": false,
      "explanation": "Reads 121- from right to left."
    },
    {
      "input": {
        "x": 10
      },
      "output": false
    }
  ],
  "hints": [
    "Reverse only half of the number and compare with the other half."
  ],
  "tests": [
    {
      "x": 121
    },
    {
      "x": -121
    },
    {
      "x": 10
    },
    {
      "x": 0
    },
    {
      "x": 7
    },
    {
      "x": 1221
    },
    {
      "x": 12321
    },
    {
      "x": 1000021
    },
    {
      "x": 2147447412
    },
    {
      "x": 2147483647
    }
  ],
  "compare": "exact",
  "timeLimitMs": 3000
}
