        "type": "int"
      }
    ],
    "returns": "int"
  },
  "examples": [
    {
      "input": {
        "n": 2
      },
      "output": 2,
      "explanation": "1+1 or 2."
    },
    {
      "input": {
        "n": 3
      },
      "output": 3,
      "explanation": "1+1+1, 1+2, 2+1."
    }
  ],
