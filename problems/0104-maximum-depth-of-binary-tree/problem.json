{
  "id": 104,
  "slug": "maximum-depth-of-binary-tree",
  "title": "Maximum Depth of Binary Tree",
  "difficulty": "Easy",
  "tags": [
    "Tree",
    "Depth-First Search",
    "Breadth-First Search"
  ],
  "statement": "Return the maximum depth of a binary tree: the number of nodes on the longest path from the root down to a leaf. An empty tree has depth `0`.\n\nTrees are given in level order with `null` for missing children.",
  "constraints": [
    "The tree has between `0` and `10^4` nodes.",
    "`-100 <= Node.val <= 100`"
  ],
  "signature": {
    "name": "maxDepth",
    "params": [
      {
        "name": "root",
        "type": "TreeNode"
      }
    ],
    "returns": "int"
  },
  "examples": [
    {
      "input": {
        "root": [
          3,
          9,
          20,
          null,
          null,
          15,
          7
        ]
      },
      "output": 3
    },
    {
      "input": {
        "root": [
          1,
          null,
          2
        ]
      },
      "output": 2
    }
  ],
  "hints": [
    "The depth of a tree is 1 plus the larger depth of its two subtrees."
  ],
  "tests": [
    {
      "root": [
        3,
        9,
        20,
        null,
        null,
        15,
        7
      ]
    },
    {
      "root": [
        1,
        null,
        2
      ]
    },
    {
      "root": []
    },
    {
      "root": [
        0
      ]
    },
    {
      "root": [
        1,
