{
  "id": 20,
  "slug": "valid-parentheses",
  "title": "Valid Parentheses",
  "difficulty": "Easy",
  "tags": [
    "String",
    "Stack"
  ],
  "statement": "A string `s` contains only the characters `(`, `)`, `{`, `}`, `[` and `]`. Decide whether it is valid.\n\nA string is valid when every opening bracket is closed by the same type of bracket, and brackets close in the correct order.",
  "constraints": [
    "`1 <= s.length <= 10^4`",
    "`s` consists only of the six bracket characters."
  ],
  "signature": {
    "name": "isValid",
    "params": [
      {
        "name": "s",
        "type": "string"
      }
    ],
    "returns": "bool"
  },
  "examples": [
    {
      "input": {
        "s": "()[]{}"
      },
      "output": true
    },
    {
      "input": {
        "s": "(]"
      },
      "output": false
    },
    {
      "input": {
        "s": "([{}])"
      },
      "output": true
    }
  ],
  "hints": [
    "The most recently opened bracket must be the first one closed."
  ],
