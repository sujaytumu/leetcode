  "title": "Add Two Numbers",
  "difficulty": "Medium",
  "tags": [
    "Linked List",
    "Math"
  ],
  "statement": "Two non-empty linked lists hold non-negative integers, one digit per node, with the **least significant digit first**. Add the two numbers and return the sum as a linked list in the same format.\n\nNeither number has leading zeros, except the number 0 itself.",
  "constraints": [
    "Each list has between `1` and `100` nodes.",
    "`0 <= Node.val <= 9`"
  ],
  "signature": {
    "name": "addTwoNumbers",
    "params": [
      {
        "name": "l1",
        "type": "ListNode"
      },
      {
        "name": "l2",
        "type": "ListNode"
      }
    ],
    "returns": "ListNode"
  },
  "examples": [
    {
      "input": {
        "l1": [
          2,
          4,
          3
        ],
        "l2": [
          5,
          6,
          4
        ]
      },
      "output": [
        7,
        0,
        8
      ],
      "explanation": "342 + 465 = 807."
    },
    {
      "input": {
        "l1": [
          9,
          9,
          9,
          9
        ],
        "l2": [
          1
        ]
      },
      "output": [
        0,
        0,
        0,
        0,
        1
      ]
    }
  ],
  "hints": [
    "Simulate schoolbook addition and carry a digit forward.",
    "A dummy head node removes special cases for the first node."
  ],
