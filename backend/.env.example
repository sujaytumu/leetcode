# Copy to backend/.env (git-ignored) and fill in. Never commit real credentials.

# Use Neon Postgres instead of the in-memory H2 database
spring.profiles.active=prod
DB_URL=jdbc:postgresql://<your-endpoint>.neon.tech/<your-db>?sslmode=require
DB_USER=<your-neon-role>
DB_PASSWORD=<your-neon-password>

# Code execution (Judge0). Leave empty to disable run/submit.
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=

# Browser origins allowed to call the API directly (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000
